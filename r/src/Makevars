# Makevars for the resolve R package.
#
# Thin client over the `resolve_c` shared library (a flat C ABI over the
# engine). No libtorch linkage and no resolve_c linkage: resolve_c is loaded at
# RUNTIME via dlopen/dlsym (src/resolve_capi_dynload.cpp), so the package builds
# and R CMD checks with no backend present. dlopen/dlsym are provided by the R
# process (which links libdl), so the shared object resolves them at load with
# no explicit PKG_LIBS entry -- kept empty to stay portable (an unconditional
# -ldl breaks on macOS, where the dl* functions live in libSystem).
#
# The only engine headers are the vendored, pure-C resolve/resolve_capi.h and
# its symbol list resolve/resolve_capi_symbols.inc under src/.
CXX_STD = CXX17

PKG_CPPFLAGS = -I.
