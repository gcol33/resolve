# Makevars for the resolve R package (issue #17).
#
# Thin client over the `resolve_c` shared library (a flat C ABI over the
# engine). No libtorch linkage: the only engine header is the vendored, pure-C
# resolve/resolve_capi.h under src/.
#
#   RESOLVE_C_HOME: directory holding libresolve_c.{so,dylib}. Must also be on
#                   LD_LIBRARY_PATH / DYLD_LIBRARY_PATH at load time so the
#                   freshly built resolve.so can resolve it.
CXX_STD = CXX17

PKG_CPPFLAGS = -I.

PKG_LIBS = -L"$(RESOLVE_C_HOME)" -lresolve_c
