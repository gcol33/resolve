# Makevars for the resolve R package.
#
# Thin client over the `resolve_c` shared library (a flat C ABI over the
# engine). No libtorch linkage and no resolve_c linkage: resolve_c is loaded at
# RUNTIME via dlopen/dlsym (src/resolve_capi_dynload.cpp), so the package builds
# and R CMD checks with no backend present. dlopen/dlsym are provided by the R
# process (which links libdl), so the shared object resolves them at load with
# no explicit PKG_LIBS entry -- kept empty to stay portable (an unconditional
# -ldl breaks on macOS, where the dl* functions live in libSystem).
#
# The only engine headers are the vendored, pure-C resolve/resolve_capi.h and
# its symbol list resolve/resolve_capi_symbols.inc under src/.
CXX_STD = CXX17

PKG_CPPFLAGS = -I.

# R reads this file before shlib.mk, so the first target named here would become
# make's default goal and the shared object would never link. Restating the real
# goal keeps it, per Writing R Extensions on adding targets in Makevars.
all: $(SHLIB)

# Every object reaches the vendored C ABI, directly or through
# resolve_capi_dynload.h, and the symbol list is what fixes the member layout of
# the function-pointer table they all share. R's build tracks .cpp timestamps
# only, so an unmodified source would otherwise keep an object compiled against
# an older list: the mismatch shifts each member's offset and calls land on a
# neighbouring symbol instead of failing to link.
$(OBJECTS): resolve/resolve_capi.h resolve/resolve_capi_symbols.inc
